float hash21(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33 + umbriel_random_seed.x);
    return fract((q.x + q.y) * q.z);
}

const float SHARD_FLIGHT = 1.0;

vec4 glassShard(vec2 uv, float gone, vec2 center, float bound, float id,
    vec3 e0, vec3 e1, vec3 e2, vec3 e3, vec3 e4, vec3 e5, vec3 e6, vec3 e7, vec3 e8) {
    float seed = hash21(vec2(id, 7.0));
    float delay = 0.02 + hash21(vec2(id, 31.0)) * 0.20;
    float duration = 0.51 + hash21(vec2(id, 54.0)) * 0.26;
    float phase = clamp((gone - delay) / duration, 0.0, 1.0);
    float fade = 1.0 - smoothstep(0.62, 1.0, phase);
    if (fade <= 0.0) return vec4(0.0);
    vec2 aspect = umbriel_size / max(min(umbriel_size.x, umbriel_size.y), 1.0);
    vec2 impact = vec2(0.35, 0.38);
    vec2 velocity = vec2(seed - 0.5, hash21(vec2(id, 19.0)) * 0.6 - 0.42);
    velocity += (center - impact) * vec2(0.55, 0.35);
    vec2 travel = velocity * phase + vec2(0.0, (0.65 + seed * 1.9) * phase * phase);
    vec2 p = (uv - center) * aspect - travel * SHARD_FLIGHT;
    float scale = 1.0 - phase * (0.12 + 0.48 * seed);
    if (length(p) > bound * max(aspect.x, aspect.y) * scale) return vec4(0.0);
    float angle = (hash21(vec2(id, 83.0)) - 0.5) * 9.0 * phase;
    float c = cos(angle), s = sin(angle);
    p = mat2(c, -s, s, c) * p;
    // Independent tumbling also foreshortens each shard, without a shared pulse.
    float tumble = 0.28 + 0.72 * abs(cos(phase * (2.0 + seed * 5.0)));
    p.x /= tumble;
    vec2 source = p / (aspect * scale) + center;
    float edge = 100.0;
    edge = min(edge, dot(e0, vec3(source, 1.0)));
    edge = min(edge, dot(e1, vec3(source, 1.0)));
    edge = min(edge, dot(e2, vec3(source, 1.0)));
    edge = min(edge, dot(e3, vec3(source, 1.0)));
    edge = min(edge, dot(e4, vec3(source, 1.0)));
    edge = min(edge, dot(e5, vec3(source, 1.0)));
    edge = min(edge, dot(e6, vec3(source, 1.0)));
    edge = min(edge, dot(e7, vec3(source, 1.0)));
    edge = min(edge, dot(e8, vec3(source, 1.0)));
    float pixel = 0.7 / max(min(umbriel_size.x, umbriel_size.y), 1.0);
    float mask = smoothstep(0.0, pixel, edge);
    if (mask <= 0.0) return vec4(0.0);
    vec4 shard = umbriel_sample(source);
    float glint = (1.0 - smoothstep(pixel, pixel * 2.8, edge))
        * (0.2 + 0.6 * abs(sin(angle + seed * 6.28318))) * sin(gone * 3.14159);
    shard.rgb *= 0.72 + 0.28 * tumble;
    shard.rgb = mix(shard.rgb, vec3(0.7, 0.9, 1.0) * shard.a, glint);
    return shard * mask * fade;
}

